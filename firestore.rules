rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario entra únicamente a lo que cuelga de su identificador.
    // Sin sesión iniciada no se lee ni se escribe nada.
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function montoValido() {
      return request.resource.data.monto is number && request.resource.data.monto > 0;
    }

    match /usuarios/{uid}/gastos/{gasto} {
      allow read, delete: if esDueno(uid);

      // Al crear o modificar se valida la forma del dato, para que la base no
      // termine con montos negativos ni con textos de largo arbitrario.
      // La categoría ya no se compara contra una lista fija: ahora las define
      // el usuario, así que acá sólo se exige que sea una referencia válida.
      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() <= 40
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 120
        // El medio de pago tampoco se compara contra una lista fija: desde la
        // segunda versión lo define el usuario, como las categorías. El campo es
        // opcional porque la primera versión, que se entrega para comparar, todavía
        // no lo escribía y sus gastos serían rechazados.
        && (!('medioId' in request.resource.data)
            || (request.resource.data.medioId is string
                && request.resource.data.medioId.size() <= 40));
    }

    match /usuarios/{uid}/ingresos/{ingreso} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 120;
    }

    match /usuarios/{uid}/categorias/{categoria} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 20
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.icono is string
        && request.resource.data.icono.size() <= 20
        && request.resource.data.orden is int;
    }

    // Medios de pago propios de cada usuario.
    match /usuarios/{uid}/medios/{medio} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 24
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.icono is string
        && request.resource.data.icono.size() <= 20
        && request.resource.data.orden is int;
    }

    // Gastos que se repiten todos los meses. El día tiene que existir en un mes.
    match /usuarios/{uid}/fijos/{fijo} {
      allow read, delete: if esDueno(uid);

      allow create, update: if esDueno(uid)
        && montoValido()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.categoria is string
        && request.resource.data.medioId is string
        && request.resource.data.medioId.size() <= 40
        && request.resource.data.diaDelMes is int
        && request.resource.data.diaDelMes >= 1
        && request.resource.data.diaDelMes <= 31;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
